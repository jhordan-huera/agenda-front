# Copia este archivo como .env.local si necesitas cambiar algo (sin él funciona en local).

# Dónde está la API (agenda-backend) en desarrollo. Vite redirige /api a esta dirección.
API_PROXY_TARGET=http://localhost:4000

# URL de la API vista desde el navegador. Por defecto "/api" (mismo dominio que el frontend,
# recomendado también en producción con una reescritura /api → backend).
# Sólo si la API está en otro dominio: VITE_API_URL=https://api.tudominio.com/api
# VITE_API_URL=/api
